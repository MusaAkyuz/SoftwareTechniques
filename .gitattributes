# Normalize all text files to LF in the repository and on checkout,
# regardless of the platform or editor used to create them. Avoids
# CRLF/LF noise showing up as full-file diffs on Windows.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
